# Адрес API. В разработке оставьте пустым — работает прокси Vite на http://localhost:4000
# В продакшене: VITE_API_URL=https://api.example.com
VITE_API_URL=

# Адрес самого сайта (для превью ссылок в Telegram/WhatsApp и canonical), без / в конце
# Например: VITE_SITE_URL=https://receipt-logs.vercel.app
VITE_SITE_URL=
